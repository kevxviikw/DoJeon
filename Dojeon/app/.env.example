# Copy to .env for local `supabase start` / `supabase functions serve` use,
# and set the same names as real secrets in your deployed project with
# `supabase secrets set NAME=value` (never commit actual values).

# Supabase project -- Settings -> API in the dashboard.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (Google AI Studio: https://aistudio.google.com/apikey).
# GEMINI_MODEL has NO default on purpose -- see
# supabase/functions/_shared/gemini.ts for why. Check
# https://ai.google.dev/gemini-api/docs/models and
# https://ai.google.dev/gemini-api/docs/pricing right before deploying and
# pick whichever current Flash model still has a live free tier.
GEMINI_API_KEY=
GEMINI_MODEL=
