# Copy to .env (gitignored) and fill in from your Supabase project's
# Settings -> API page. These are inlined into the client bundle at build
# time (EXPO_PUBLIC_ prefix) -- that's expected, the anon key is meant to
# be public, RLS is what actually protects data. Never put the Gemini key
# or the Supabase service-role key here; those live only in Edge Function
# secrets (see ../.env.example).

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
