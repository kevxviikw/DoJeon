{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    // Off-device dev: build this once, install on your iPhone, then run
    // `npx expo start --dev-client` instead of Expo Go.
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    // Ad-hoc / internal QA build (registered devices only, no TestFlight).
    "preview": {
      "distribution": "internal",
      "ios": { "simulator": false }
    },
    // TestFlight + App Store. autoIncrement bumps the build number so
    // "bundle version must be higher" never happens.
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "ios": {
        // ascAppId is filled in automatically after the first successful
        // `eas submit` creates the App Store Connect app record.
        "appleId": "kwkim16@icloud.com",
        "appleTeamId": "7KDTHKJULP"
      }
    }
  }
}
