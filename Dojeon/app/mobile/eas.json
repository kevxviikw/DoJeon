{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    // Off-device dev: build this once, install on your iPhone, then run
    // `npx expo start --dev-client` instead of Expo Go.
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    // Ad-hoc / internal QA build (registered devices only, no TestFlight).
    "preview": {
      "distribution": "internal",
      "ios": { "simulator": false }
    },
    // TestFlight + App Store. autoIncrement bumps the build number so
    // "bundle version must be higher" never happens.
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "ios": {
        // Fill these in after enrolling in the Apple Developer Program.
        // appleId    = your Apple ID email
        // appleTeamId = App Store Connect -> Membership -> Team ID
        // ascAppId   = the app's numeric ID in App Store Connect (created
        //              on first `eas submit`, or via `eas build --submit`)
        "appleId": "kwkim16@icloud.com",
        "appleTeamId": "7KDTHKJULP",
        "ascAppId": "YOUR_ASC_APP_ID"
      }
    }
  }
}
